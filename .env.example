# 生产环境必填：反向代理对外提供 HTTPS，Node 服务仍只监听 127.0.0.1
NODE_ENV=production
PORT=4173
CLUB_PUBLIC_ORIGIN=https://club.example.com/
CLUB_DATABASE=C:/data/club/club.sqlite
CLUB_ADMIN_USERNAME=club_owner
CLUB_ADMIN_PASSWORD=请替换为至少12位且含字母数字符号的强密码
CLUB_ADMIN_NAME=星河俱乐部管理员
# 派单大厅公网语音：配置运营方自己的 STUN / TURN 服务；默认 [] 仅尝试直连。
# TURN 凭据仅经登录后的入房接口返回，请使用专用、限额的凭据并定期轮换。
# 示例：[{"urls":"stun:stun.example.com:3478"},{"urls":"turns:turn.example.com:5349","username":"club-voice","credential":"replace-me"}]
CLUB_ICE_SERVERS=[]
